NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://localhost:5432/web2_lab1

# Ista Auth0 authority adresa za web-prijavu i M2M API.
AUTH0_ISSUER_BASE_URL=
AUTH0_AUDIENCE=https://web2-lab1/passes
# Regular Web Application (OIDC), ne M2M aplikacija.
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Generirati: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Samo za lokalni automat; web-serveru nisu potrebne M2M tajne.
M2M_CLIENT_ID=
M2M_CLIENT_SECRET=
